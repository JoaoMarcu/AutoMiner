{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoMiner Manager",
  "version": "1.0.0",
  "identifier": "dev.autominer.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm manager:web",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{ "title": "AutoMiner Manager", "width": 1342, "height": 864, "minWidth": 960, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8765" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AutoMiner",
    "shortDescription": "Instalador e gerenciador do AutoMiner",
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
